# ============================================
# KV Artchives — Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Supabase ---
# Settings > General
SUPABASE_URL=https://your-project-ref.supabase.co

# Settings > API Keys > Publishable key (safe for browser)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Settings > API Keys > Secret key (SERVER ONLY — bypasses RLS)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# --- Session ---
# Any long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string

# --- Business rules ---
DOWN_PAYMENT_PERCENT=60
DOWN_PAYMENT_EXPIRY_DAYS=3

# --- Email (Phase 8, leave blank for now) ---
RESEND_API_KEY=
MAIL_FROM=
