<link rel="stylesheet" href="/css/account-settings.css">
<link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
>

<main class="account-page">

    <section class="account-header">
        <h1>Account Settings</h1>
        <p>Manage your personal information and delivery details.</p>
    </section>

    <section class="account-content">

        <div class="account-card personal-card">

            <div class="card-title">
                <i class="fa-solid fa-user"></i>
                <span>Personal Information</span>

                <a href="#" class="edit-link">✎ Edit</a>
            </div>

            <div class="personal-info-grid">

                <div class="info-item">
                    <span class="info-label">Full Name</span>
                    <span class="info-value">
                        <%= user.full_name || "Not provided" %>
                    </span>
                </div>

                <div class="info-item">
                    <span class="info-label">Contact Number</span>
                    <span class="info-value">
                        <%= user.contact_no || "Not provided" %>
                    </span>
                </div>

                <div class="info-item">
                    <span class="info-label">Email Address</span>
                    <span class="info-value">
                        <%= user.email || "Not provided" %>
                    </span>
                </div>

            </div>

        </div>

        <div class="account-card address-card">

            <div class="card-title">
                <i class="fa-solid fa-location-dot"></i>
                <span>Delivery Address</span>
            </div>

            <p class="card-description">
                Your most recent delivery address is used to fill in the
                checkout form automatically. You can change it at checkout.
            </p>

            <div class="address-box">

                <div class="address-top">
                    <strong>
                        <%= user.full_name || "Your Name" %>
                    </strong>
                </div>

                <p>
                    ☎ <%= user.contact_no || "No contact number" %>
                </p>

                <p>
                    Your delivery address appears here after your first order.
                </p>

            </div>

        </div>

        <div class="account-card password-card">

            <div class="card-title">
                <i class="fa-solid fa-key"></i>
                <span>Password</span>

                <a href="/forgot-password" class="change-password">
                    Change Password
                </a>
            </div>

            <div class="password-info">

                <span class="info-label">Current Password</span>

                <span class="password-dots">
                    ••••••••••••
                </span>

            </div>

        </div>

    </section>

</main>