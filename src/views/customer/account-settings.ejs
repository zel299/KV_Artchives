<main class="account-page">

    <section class="account-header">
        <h1>Account Settings</h1>
        <p>Manage your personal information and delivery details.</p>
    </section>

    <section class="account-content">

        <div class="account-card personal-card">

            <div class="card-title">
                <i class="fa-solid fa-user"></i>
                <span>Personal Information</span>
            </div>

            <div class="personal-info-grid">

                <div class="info-item">
                    <span class="info-label">Full Name</span>
                    <span class="info-value">
                        <%= user.full_name || "Not provided" %>
                    </span>
                </div>

                <div class="info-item">
                    <span class="info-label">Contact Number</span>
                    <span class="info-value">
                        <%= user.contact_no || "Not provided" %>
                    </span>
                </div>

                <div class="info-item">
                    <span class="info-label">Email Address</span>
                    <span class="info-value">
                        <%= user.email %>
                    </span>
                </div>

            </div>

        </div>

        <div class="account-card address-card">

            <div class="card-title">
                <i class="fa-solid fa-location-dot"></i>
                <span>Delivery Address</span>
            </div>

            <p class="card-description">
                This is the address from your most recent order. It fills in the
                checkout form automatically, and you can change it there.
            </p>

            <div class="address-box">

                <% if (lastAddress) { %>

                    <div class="address-top">
                        <strong><%= lastAddress.full_name %></strong>
                    </div>

                    <p>☎ <%= lastAddress.contact_no %></p>
                    <p><%= lastAddress.address %></p>
                    <% if (lastAddress.barangay) { %><p><%= lastAddress.barangay %></p><% } %>
                    <p><%= lastAddress.city %>, <%= lastAddress.province %> <%= lastAddress.zip %></p>

                <% } else { %>

                    <p class="address-empty">
                        Your delivery address will appear here after your first order.
                    </p>

                <% } %>

            </div>

        </div>

        <div class="account-card password-card">

            <div class="card-title">
                <i class="fa-solid fa-key"></i>
                <span>Password</span>

                <a href="/account/password" class="change-password">
                    Change Password
                </a>
            </div>

            <div class="password-info">

                <span class="info-label">Current Password</span>

                <span class="password-dots">
                    ••••••••••••
                </span>

            </div>

        </div>

    </section>

</main>