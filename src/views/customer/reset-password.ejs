<section class="narrow card">
  <h1>Set a new password</h1>
  <% if (error) { %><div class="alert"><%= error %></div><% } %>

  <form method="post" action="/reset-password" id="resetForm">
    <input type="hidden" name="access_token" id="access_token">
    <label>New password
      <input type="password" name="password" required minlength="8">
    </label>
    <label>Confirm new password
      <input type="password" name="confirm_password" required minlength="8">
    </label>
    <button type="submit" class="btn btn-block">Update password</button>
  </form>
</section>

<script>
  // Supabase puts the token in the URL fragment, which the server never sees.
  const params = new URLSearchParams(window.location.hash.slice(1));
  const token = params.get('access_token');
  if (token) document.getElementById('access_token').value = token;
</script>
