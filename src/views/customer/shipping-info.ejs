<link rel="stylesheet" href="/css/info-pages.css"> 

<main class="shipping-page">

    <section class="shipping-hero">
        <h1>Shipping Information</h1>
        <p>
            Learn how we carefully prepare, package, and deliver your handmade
            creations with the utmost care.
        </p>
    </section>

    <section class="shipping-notice">

        <div class="notice-icon">
            ⓘ
        </div>

        <div class="notice-content">
            <h3>IMPORTANT NOTICE</h3>

            <p>
                Please note: Since our products are handmade, some orders may
                require additional processing time to ensure the best quality
                and structural integrity before transit.
            </p>
        </div>

    </section>



    <section class="shipping-journey">

        <h2>The Journey of Your Piece</h2>

        <div class="journey-timeline">

            <div class="journey-step">

                <div class="journey-icon">📄</div>

                <div class="journey-line"></div>

                <h3>ORDER PLACED</h3>
                <p>Confirmation received</p>

            </div>


            <div class="journey-step">

                <div class="journey-icon">🎨</div>

                <div class="journey-line"></div>

                <h3>PROCESSING</h3>
                <p>Handmade preparation</p>

            </div>


            <div class="journey-step">

                <div class="journey-icon">🚚</div>

                <div class="journey-line"></div>

                <h3>SHIPPED</h3>
                <p>In transit to you</p>

            </div>


            <div class="journey-step">

                <div class="journey-icon">📦</div>

                <h3>DELIVERED</h3>
                <p>Arrived safely</p>

            </div>

        </div>

    </section>


    <section class="shipping-details">

        <article class="shipping-detail">

            <div class="detail-icon">
                ⌛
            </div>

            <h2>Processing Time</h2>

            <p>
                Because each piece is individually crafted and finished by hand,
                we require a dedicated processing period before shipping.
                Please allow 3–5 business days for us to meticulously inspect
                and securely package your ceramic pieces.
            </p>

        </article>


        <article class="shipping-detail">

            <div class="detail-icon">
                🔎
            </div>

            <h2>Order Tracking</h2>

            <p>
                Once your order has been carefully boxed and handed over to our
                couriers, you will receive a shipping confirmation email containing
                a unique tracking number. You can use this to monitor your parcel's
                journey to your home.
            </p>

        </article>

    </section>



    <section class="shipping-methods">

        <h2>Shipping Methods &amp; Fees</h2>

        <div class="methods-divider"></div>

        <div class="method-grid">

            <article class="shipping-method-card">

                <h3>Standard Artisan Delivery</h3>

                <p>
                    Careful, ground-based transit designed for fragile items.
                </p>

                <div class="method-divider"></div>

                <div class="method-info">

                    <div>
                        <span>EST. TIME</span>
                        <strong>5-7 Business Days</strong>
                    </div>

                    <div class="method-fee">
                        <span>FEE</span>
                        <strong>₱150.00</strong>
                    </div>

                </div>

            </article>

            <article class="shipping-method-card">

                <h3>Express Priority</h3>

                <p>
                    Expedited handling and air transit for faster arrival.
                </p>

                <div class="method-divider"></div>

                <div class="method-info">

                    <div>
                        <span>EST. TIME</span>
                        <strong>2-3 Business Days</strong>
                    </div>

                    <div class="method-fee">
                        <span>FEE</span>
                        <strong>₱250.00</strong>
                    </div>

                </div>

            </article>

        </div>

    </section>


    <section class="shipping-bottom-grid">

        <article class="shipping-bottom-card">

            <div class="bottom-icon">
                🕑
            </div>

            <h2>Delays &amp; Issues</h2>

            <p>
                While we strive for punctuality, external factors such as severe
                weather or carrier disruptions may occasionally cause delays.
                We appreciate your patience as we ensure your delicate items
                arrive safely.
            </p>

        </article>


        <article class="shipping-bottom-card">

            <div class="bottom-icon">
                📦
            </div>

            <h2>Damaged Packages</h2>

            <p>
                Ceramics are fragile by nature. If your piece arrives damaged,
                please retain all packaging and contact our support team within
                48 hours with photographic evidence for a swift resolution.
            </p>

        </article>

    </section>

</main>