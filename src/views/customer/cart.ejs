<main class="cart-page">

    <section class="cart-header">
        <h1>Your Cart</h1>
        <p>
            Review your selected pieces before checkout.
        </p>
    </section>

    <% if (items.length === 0) { %>

        <section class="empty-cart">
            <h2>
                NO ITEM/S IN YOUR CART
            </h2>
        </section>

    <% } else { %>

        <section class="cart-layout">

            <section class="cart-items">
                <% items.forEach(function (item) { %>

                    <article class="cart-item">

                        <img
                            src="<%= item.product.primaryImage ? item.product.primaryImage.url : '/images/placeholder.png' %>"
                            alt="<%= item.product.name %>"
                        >

                        <div class="cart-item-info">

                            <h3>
                                <a href="/products/<%= item.product.id %>">
                                    <%= item.product.name %>
                                </a>
                            </h3>

                            <p class="cart-item-price">
                                <%= formatPeso(item.product.price) %>
                            </p>

                            <% if (!item.product.inStock) { %>

                                <span class="badge sold-out">
                                    Sold out
                                </span>

                            <% } %>

                            <form
                                method="post"
                                action="/cart/<%= item.id %>/update"
                                class="cart-qty-form"
                            >
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                <button
                                    type="button"
                                    class="qty-btn qty-minus"
                                    aria-label="Decrease quantity"
                                >
                                    −
                                </button>

                                <input
                                    type="number"
                                    name="quantity"
                                    value="<%= item.quantity %>"
                                    min="1"
                                    step="1"
                                >

                                <button
                                    type="button"
                                    class="qty-btn qty-plus"
                                    aria-label="Increase quantity"
                                >
                                    +
                                </button>

                                <button
                                    type="submit"
                                    class="qty-update"
                                >
                                    Update
                                </button>
                            </form>

                        </div>

                        <p class="cart-line-total">
                            <%= formatPeso(item.lineTotal) %>
                        </p>

                        <form
                            method="post"
                            action="/cart/<%= item.id %>/remove"
                            class="cart-remove-form"
                        >
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                            <button
                                type="submit"
                                class="cart-remove"
                                aria-label="Remove item"
                            >
                                &times;
                            </button>
                        </form>
                    </article>

                <% }); %>

            </section>

            <section class="cart-summary">
                <div class="cart-summary-heading">
                    Order Summary
                </div>

                <div class="cart-total">
                    <span>
                        Subtotal
                    </span>

                    <strong><%= formatPeso(subtotal) %></strong>
                </div>

                <p class="cart-note">
                    Shipping is calculated after your order is confirmed.
                </p>

                <a href="/checkout" class="btn btn-primary">
                    Proceed to Checkout
                </a>
            </section>
        </section>

    <% } %>

</main>

<script>
document.addEventListener("DOMContentLoaded", function () {

    document.querySelectorAll(".cart-qty-form").forEach(function (form) {

        const minusButton = form.querySelector(".qty-minus");
        const plusButton = form.querySelector(".qty-plus");
        const quantityInput = form.querySelector('input[name="quantity"]');

        if (!quantityInput) return;

        if (minusButton) {
            minusButton.addEventListener("click", function () {
                let quantity = parseInt(quantityInput.value) || 1;

                if (quantity > 1) {
                    quantityInput.value = quantity - 1;
                    form.submit();
                }
            });
        }

        if (plusButton) {
            plusButton.addEventListener("click", function () {
                let quantity = parseInt(quantityInput.value) || 1;
                quantityInput.value = quantity + 1;
                form.submit();
            });
        }
    });

});
</script>