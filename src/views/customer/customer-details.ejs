<link rel="stylesheet" href="/css/customer-details.css">

<section class="checkout-hero">
    <h1 class="checkout-hero__title">
        Almost There! <span class="heart">&#9825;</span>
    </h1>

    <p class="checkout-hero__subtitle">
        Tell us where to send your handmade pieces.
    </p>
</section>

<section class="checkout-card">
    <form class="checkout-form" action="/checkout" method="POST">

        <div class="checkout-form__grid">

            <div class="form-column">
                <h2 class="form-column__title">Customer Information</h2>

                <div class="form-group">
                    <label for="fullName">Full Name</label>
                    <input
                        type="text"
                        id="fullName"
                        name="fullName"
                        placeholder="Enter your full name"
                        value="<%= locals.fullName || '' %>"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="email">Email</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="hello@example.com"
                        value="<%= locals.email || '' %>"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="phone">Phone Number</label>
                    <input
                        type="tel"
                        id="phone"
                        name="phone"
                        placeholder="+63 900 000 0000"
                        value="<%= locals.phone || '' %>"
                        required
                    >
                </div>
            </div>

            <div class="form-column">
                <h2 class="form-column__title">Delivery Address</h2>

                <div class="form-group">
                    <label for="street">House No. &amp; Street Address</label>
                    <input
                        type="text"
                        id="street"
                        name="street"
                        placeholder="123 Clay Street, Studio 4"
                        value="<%= locals.street || '' %>"
                        required
                    >
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="barangay">Barangay</label>
                        <input
                            type="text"
                            id="barangay"
                            name="barangay"
                            value="<%= locals.barangay || '' %>"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label for="city">City</label>
                        <input
                            type="text"
                            id="city"
                            name="city"
                            value="<%= locals.city || '' %>"
                            required
                        >
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="province">Province</label>
                        <input
                            type="text"
                            id="province"
                            name="province"
                            value="<%= locals.province || '' %>"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label for="zip">ZIP Code</label>
                        <input
                            type="text"
                            id="zip"
                            name="zip"
                            value="<%= locals.zip || '' %>"
                            required
                        >
                    </div>
                </div>
            </div>

        </div>

        <hr class="divider">

        <div class="form-group form-group--full">
            <label for="orderNote">Order Note (Optional)</label>

            <textarea
                id="orderNote"
                name="orderNote"
                rows="4"
                placeholder="Special instructions for delivery or a sweet message..."
            ><%= locals.orderNote || '' %></textarea>
        </div>

        <div class="checkbox-group">
            <input
                type="checkbox"
                id="saveAddress"
                name="saveAddress"
                <%= locals.saveAddress ? 'checked' : '' %>
            >

            <label for="saveAddress">
                Save this address as my default address

                <span class="checkbox-group__hint">
                    This will be used for your future orders.
                </span>
            </label>
        </div>

        <hr class="divider">

        <button type="submit" class="btn-checkout">
            Continue to Checkout
        </button>

    </form>
</section>