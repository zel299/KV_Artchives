
<main class="checkout-page">

    <div class="container">

        <section class="checkout-header">
            <h1>Checkout</h1>
            <p>Confirm your delivery details to place your order.</p>
        </section>

        <% if (error) { %>
            <div class="alert"><%= error %></div>
        <% } %>

        <div class="checkout-layout">

            <form method="post" action="/checkout" class="checkout-form">

                <h2>Delivery Details</h2>

                <div class="form-group">
                    <label for="full_name">Full Name</label>
                    <input type="text" id="full_name" name="full_name" value="<%= values.full_name %>" required>
                </div>

                <div class="form-group">
                    <label for="contact_no">Contact Number</label>
                    <input type="text" id="contact_no" name="contact_no" value="<%= values.contact_no %>" required>
                </div>

                <div class="form-group">
                    <label for="address">Street Address</label>
                    <input type="text" id="address" name="address" value="<%= values.address %>" required>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="city">City</label>
                        <input type="text" id="city" name="city" value="<%= values.city %>" required>
                    </div>

                    <div class="form-group">
                        <label for="province">Province</label>
                        <input type="text" id="province" name="province" value="<%= values.province %>" required>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Place Order</button>

            </form>

            <aside class="checkout-summary">

                <h2>Order Summary</h2>

                <% items.forEach(function (item) { %>
                    <div class="summary-line">
                        <span><%= item.product.name %> &times; <%= item.quantity %></span>
                        <span><%= formatPeso(item.lineTotal) %></span>
                    </div>
                <% }); %>

                <div class="summary-line summary-subtotal">
                    <span>Subtotal</span>
                    <strong><%= formatPeso(subtotal) %></strong>
                </div>

                <div class="summary-line summary-down">
                    <span>Down payment (60%)</span>
                    <strong><%= formatPeso(downPayment) %></strong>
                </div>

                <p class="checkout-note">
                    Placing an order does not charge you yet. Once we confirm it,
                    you will be asked to pay the down payment of
                    <strong><%= formatPeso(downPayment) %></strong>. Shipping is
                    calculated later and added to the balance.
                </p>

            </aside>

        </div>

    </div>

</main>