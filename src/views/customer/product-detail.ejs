<section class="product-page">

    <div class="container">

        <a href="/shop" class="back-link">&larr; Back to shop</a>

        <div class="product-detail">

            <div class="product-gallery">

                <% if (product.images.length === 0) { %>
                    <img src="/images/placeholder.png" alt="<%= product.name %>" class="product-main-image">
                <% } else { %>
                    <img src="<%= product.images[0].url %>" alt="<%= product.name %>" class="product-main-image" id="mainImage">

                    <% if (product.images.length > 1) { %>
                        <div class="product-thumbs">
                            <% product.images.forEach(function (img) { %>
                                <img src="<%= img.url %>" alt="<%= product.name %>" class="product-thumb" data-full="<%= img.url %>">
                            <% }); %>
                        </div>
                    <% } %>
                <% } %>

            </div>

            <div class="product-summary">

                <p class="product-code"><%= product.code %></p>

                <h1><%= product.name %></h1>

                <p class="product-price"><%= formatPeso(product.price) %></p>

                <div class="product-badges">
                    <% if (product.inStock) { %>
                        <span class="badge in-stock">In stock</span>
                    <% } else { %>
                        <span class="badge sold-out">Sold out</span>
                    <% } %>

                    <% if (product.isOneOfAKind) { %>
                        <span class="badge one-of-a-kind">One of a kind</span>
                    <% } %>
                </div>

                <% if (product.description) { %>
                    <p class="product-description"><%= product.description %></p>
                <% } %>

                <% if (product.category) { %>
                    <p class="product-category">Category: <%= product.category.name %></p>
                <% } %>

                <% if (product.inStock) { %>

                    <form method="post" action="/cart/add" class="add-to-cart-form">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="product_id" value="<%= product.id %>">

                        <label for="quantity" class="qty-label">Quantity</label>
                        
                        <div class="product-qty-control">
                            <button
                                type="button"
                                class="qty-btn qty-minus"
                                aria-label="Decrease quantity"
                            >
                                −
                            </button>

                            <input
                                type="number"
                                id="quantity"
                                name="quantity"
                                value="1"
                                min="1"
                                step="1"
                            >

                            <button
                                type="button"
                                class="qty-btn qty-plus"
                                aria-label="Increase quantity"
                            >
                                +
                            </button>
                        </div>

                        <button type="submit" class="btn btn-primary">Add to Cart</button>
                    </form>

                <% } else { %>
                    <button type="button" class="btn btn-primary" disabled>Sold Out</button>
                <% } %>

            </div>

        </div>

    </div>

</section>

<script>
document.addEventListener("DOMContentLoaded", function () {

    const quantityInput = document.getElementById("quantity");
    const minusButton = document.querySelector(".product-qty-control .qty-minus");
    const plusButton = document.querySelector(".product-qty-control .qty-plus");

    if (!quantityInput || !minusButton || !plusButton) return;

    minusButton.addEventListener("click", function () {
        let quantity = parseInt(quantityInput.value) || 1;

        if (quantity > 1) {
            quantity--;
            quantityInput.value = quantity;
        }
    });

    plusButton.addEventListener("click", function () {
        let quantity = parseInt(quantityInput.value) || 1;

        quantity++;
        quantityInput.value = quantity;
    });

    quantityInput.addEventListener("input", function () {
        let quantity = parseInt(quantityInput.value) || 1;

        if (quantity < 1) {
            quantity = 1;
        }

        quantityInput.value = quantity;
    });

});
</script>