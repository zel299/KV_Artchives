<main class="order-submitted-page">

    <section class="order-success-header">

        <div class="success-icon">
            <span>✓</span>
        </div>

        <h1>Order Submitted!</h1>

        <p>
            Your order has been successfully submitted and is now
            <strong>waiting for seller confirmation.</strong>
        </p>

    </section>

    <section class="order-card">

        <h2>Order Summary</h2>

        <p class="order-code">Order <%= order.code %></p>

        <div class="order-items">

            <% order.items.forEach(function (item) { %>

                <div class="order-item">

                    <div class="product-details">

                        <span class="product-name">
                            <%= item.name %>
                        </span>

                        <span class="product-qty">
                            Qty: <%= item.quantity %>
                        </span>

                    </div>

                    <div class="product-price">
                        <%= formatPeso(item.lineTotal) %>
                    </div>

                </div>

            <% }); %>

        </div>

        <div class="summary-divider"></div>

        <div class="summary-row">
            <span>Subtotal</span>
            <span><%= formatPeso(order.subtotal) %></span>
        </div>

        <div class="summary-row">
            <span>Shipping</span>
            <span>Calculated later</span>
        </div>

        <div class="summary-divider total-divider"></div>

        <div class="summary-row total-row">
            <span>Down payment (60%)</span>
            <strong><%= formatPeso(order.downPaymentAmount) %></strong>
        </div>

        <div class="important-note">

            <div class="important-note-title">
                <span class="note-icon">!</span>
                <strong>IMPORTANT NOTE!</strong>
            </div>

            <p>
                Please wait for the seller's confirmation before making
                your <strong>60% down payment via GCash</strong>. Once your
                order is confirmed, the payment instructions will appear
                in My Orders.
            </p>

            <p>
                The remaining balance, together with the shipping fee, is
                requested once your pieces are finished and ready to ship.
            </p>

            <p>
                Please complete your down payment within
                <strong>3 days after confirmation</strong> to avoid
                automatic cancellation.
            </p>

        </div>

    </section>

    <div class="order-actions">

        <a href="/account/orders" class="view-order-btn">
            View my Orders
        </a>

        <a href="/shop" class="back-shop-btn">
            Back to Shop
        </a>

    </div>

</main>