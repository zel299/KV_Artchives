<section class="narrow card">
  <h1>Forgot password</h1>

  <% if (sent) { %>

    <p>If that email has an account, a reset link is on its way.</p>

    <p class="muted small">
      Emails can take a few minutes to arrive. Please check your spam folder
      before requesting another link.
    </p>

    <a href="/login" class="btn">Back to log in</a>

  <% } else { %>

    <p class="muted">Enter your email and we will send you a reset link.</p>

    <% if (error) { %><div class="alert"><%= error %></div><% } %>

    <form method="post" action="/forgot-password">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <label>Email
        <input type="email" name="email" required>
      </label>

      <button type="submit" class="btn btn-block">Send reset link</button>
    </form>

  <% } %>
</section>