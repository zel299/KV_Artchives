<section class="narrow card">
  <h1>Forgot password</h1>
  <% if (sent) { %>
    <p>If that email has an account, a reset link is on its way.</p>
    <a href="/login" class="btn">Back to log in</a>
  <% } else { %>
    <p class="muted">Enter your email and we will send you a reset link.</p>
    <% if (error) { %><div class="alert"><%= error %></div><% } %>
    <form method="post" action="/forgot-password">
      <label>Email
        <input type="email" name="email" required>
      </label>
      <button type="submit" class="btn btn-block">Send reset link</button>
    </form>
  <% } %>
</section>
