<link rel="stylesheet" href="/css/info-pages.css">
<link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
/>

<main class="info-page contact-page">

    <section class="contact-hero">
        <h1>Have a question or an idea?</h1>

        <p>
            We'd love to hear from you! Whether you're curious about a specific piece,
            want to discuss a custom commission, or just want to say hello.
        </p>
    </section>


    <section class="contact-cards">
        <article class="contact-card">

            <div class="contact-icon">
                <i class="fa-brands fa-instagram"></i>
            </div>

            <h2>Instagram</h2>

            <p>
                Follow us for behind-the-scenes peeks, process videos,
                and our latest creations. Drop us a DM anytime!
            </p>

            <span class="contact-handle">@kv_artchives</span>

            <a
                href="https://www.instagram.com/kv_artchives"
                target="_blank"
                rel="noopener noreferrer"
                class="contact-button"
            >
                Message us on Instagram
            </a>

        </article>

        <article class="contact-card">

            <div class="contact-icon">
                <i class="fa-brands fa-facebook-f"></i>
            </div>

            <h2>Facebook</h2>

            <p>
                Join our community on Facebook for updates on local markets,
                new batch releases, and event news.
            </p>

            <span class="contact-handle">KV Artchives</span>

            <a
                href= "https://www.facebook.com/profile.php?id=61582593320686&mibextid=wwXIfr"
                target="_blank"
                rel="noopener noreferrer"
                class="contact-button"
            >
                Message us on Facebook
            </a>

        </article>

    </section>

    <section class="custom-orders">

        <div class="custom-order-icon">
            <i class="fa-solid fa-circle-info"></i>
        </div>

        <h2>About Custom Orders</h2>

        <p>
            Please note that all custom orders and commissions are currently handled
            directly through our social messaging channels. Reach out via Instagram
            or Facebook to get started!
        </p>

    </section>

</main>