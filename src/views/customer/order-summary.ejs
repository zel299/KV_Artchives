<section class="order-hero">

    <h1 class="order-hero__title">
        Complete Your Order
    </h1>

    <p class="order-hero__subtitle">
        Almost yours. Just a few details to finalize your order.
    </p>

</section>

<section class="order-review">

    <% if (error) { %>
        <div class="alert"><%= error %></div>
    <% } %>

    <div class="order-review__grid">

        <!-- LEFT: CUSTOMER INFORMATION -->
        <div class="order-review__left">

            <div class="panel customer-details-panel">

                <h2 class="panel__title">
                    <span><i class="fa-solid fa-user"></i></span>
                    Customer Information
                </h2>

                <div class="info-group">
                    <label>Full Name</label>
                    <p class="info-value">
                        <%= values.full_name %>
                    </p>
                </div>

                <div class="info-group">
                    <label>Email</label>
                    <p class="info-value info-value--disabled">
                        <%= user.email %>
                    </p>
                </div>

                <div class="info-group">
                    <label>Contact Number</label>
                    <p class="info-value">
                        <%= values.contact_no %>
                    </p>
                </div>

                <div class="section-divider"></div>

                <h2 class="panel__title">
                    <span><i class="fa-solid fa-map-pin"></i></span>
                    Delivery Address
                </h2>

                <div class="address-box">

                    <p class="address-box__name">
                        <%= values.full_name %>
                    </p>

                    <p> <%= values.contact_no %></p>
                    <p> <%= values.address %></p>
                    

                    <p>
                        <%= values.barangay %>,
                        <%= values.city %>,
                        <%= values.province %>
                        <%= values.zip %>
                    </p>

                </div>

                <div class="address-actions">

                    <a href="/checkout" class="btn-pill btn-pill--edit">
                        <span class="icon">&#9998;</span>
                        Edit Details
                    </a>

                </div>

            </div>

        </div>

        <div class="order-review__right">

            <div class="summary-card">

                <div class="summary-card__header">
                    <span><i class="fa-regular fa-file-lines"></i></span>
                    Order Summary
                </div>

                <div class="summary-card__body">

                    <% items.forEach(function (item) { %>

                        <div class="summary-item">

                            <img
                                src="<%= item.product.primaryImage ? item.product.primaryImage.url : '/images/placeholder.png' %>"
                                alt="<%= item.product.name %>"
                                class="summary-item__img"
                            >

                            <div class="summary-item__info">

                                <p class="summary-item__name">
                                    <%= item.product.name %>
                                </p>

                                <p class="summary-item__category">
                                    <%= item.product.category
                                        ? item.product.category.name
                                        : '' %>
                                </p>

                                <span class="summary-item__qty">
                                    Qty: <%= item.quantity %>
                                </span>

                            </div>

                            <div class="summary-item__price">
                                <%= formatPeso(item.lineTotal) %>
                            </div>

                        </div>

                    <% }); %>


                    <% if (values.customer_note) { %>

                        <div class="order-note">

                            <p class="order-note__title">
                                <span><i class="fa-solid fa-file-pen"></i></span>
                                Order Note
                            </p>

                            <p class="order-note__text">
                                "<%= values.customer_note %>"
                            </p>

                        </div>

                    <% } %>

                </div>


                <div class="summary-card__totals">

                    <div class="totals-row">

                        <span>Subtotal</span>

                        <span>
                            <%= formatPeso(subtotal) %>
                        </span>

                    </div>

                    <div class="totals-row">

                        <span>Down payment (60%)</span>

                        <span>
                            <%= formatPeso(downPayment) %>
                        </span>

                    </div>

                    <hr>

                    <div class="totals-row totals-row--total">

                        <span>Due after confirmation</span>

                        <span>
                            <%= formatPeso(downPayment) %>
                        </span>

                    </div>


                    <form action="/checkout" method="POST">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                        <input
                            type="hidden"
                            name="full_name"
                            value="<%= values.full_name %>"
                        >

                        <input
                            type="hidden"
                            name="contact_no"
                            value="<%= values.contact_no %>"
                        >

                        <input
                            type="hidden"
                            name="address"
                            value="<%= values.address %>"
                        >

                        <input
                            type="hidden"
                            name="barangay"
                            value="<%= values.barangay %>"
                        >

                        <input
                            type="hidden"
                            name="city"
                            value="<%= values.city %>"
                        >

                        <input
                            type="hidden"
                            name="province"
                            value="<%= values.province %>"
                        >

                        <input
                            type="hidden"
                            name="zip"
                            value="<%= values.zip %>"
                        >

                        <input
                            type="hidden"
                            name="customer_note"
                            value="<%= values.customer_note || '' %>"
                        >

                        <button
                            type="submit"
                            class="btn-submit"
                        >
                            Submit Order
                        </button>

                    </form>

                </div>

            </div>

            <div class="notice">

                <div class="notice__icon">
                    !
                </div>

                <div>

                    <h3 class="notice__title">
                        ORDER CONFIRMATION & DOWNPAYMENT
                    </h3>

                    <p class="notice__text">
                        Once your order is confirmed, a 60% downpayment will be required. You will then receive instructions for payment via GCash.
                        The downpayment must be paid within 3 days after seller confirmation to keep your order active.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>