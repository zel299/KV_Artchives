<link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
>
<header class="site-header">

    <div class="container nav-inner">

        <a href="/" class="brand">

            <div class="brand-logo">
                <img src="/images/logo.png" alt="KV Artchives">
            </div>

            <span>KV Artchives</span>

        </a>


        <nav class="nav-links">

            <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">HOME</a>

            <a href="/about" class="<%= currentPath === '/about' ? 'active' : '' %>">ABOUT</a>

            <a href="/gallery" class="<%= currentPath === '/gallery' ? 'active' : '' %>">GALLERY</a>

            <a href="/shop" class="<%= currentPath.startsWith('/shop') || currentPath.startsWith('/products') ? 'active' : '' %>">SHOP</a>

            <a href="/commissions" class="<%= currentPath === '/commissions' ? 'active' : '' %>">COMMISSIONS</a>

        </nav>


        <div class="nav-actions">

            <% if (user) { %>

                <div class="account-menu">

                    <button type="button" class="account-btn" id="accountBtn">
                        HI, <%= user.full_name && user.full_name.includes(" ") ? user.full_name.split(" ")[0].toUpperCase() : "THERE" %>!
                        <span class="account-arrow"><i class="fa-solid fa-chevron-down"></i></span>
                    </button>

                    <div class="account-dropdown" id="accountDropdown">
                        <a href="/account/orders">
                            <span <i class="fa-solid fa-list"></i> </span>
                            My Orders
                        </a>
                        <a href="/account">
                            <span <i class="fa-regular fa-user"></i> </span>
                            Account Settings
                        </a>

                        <div class="dropdown-divider"></div>

                        <a href="/logout">
                            <span <i class="fa-solid fa-arrow-right-from-bracket"></i> </span>
                            Log Out 
                        </a>
                    </div>

                </div>

            <% } else { %>

                <a href="/login">LOG IN</a>

            <% } %>


            <a href="/cart" class="cart-btn" aria-label="Shopping Cart">
                <svg viewBox="0 0 120 120" aria-hidden="true">

                    <path d="M12 12 H30 L48 65" class="cart-line" />
                    <path d="M30 28 H108 L84 65 H48" class="cart-basket" />
                    <path d="M48 65 L38 88 H98" class="cart-bottom" />

                    <circle cx="50" cy="105" r="10" />
                    <circle cx="88" cy="105" r="10" />

                </svg>
            </a>

        </div>

    </div>

</header>

<script>
    const accountBtn = document.getElementById("accountBtn");
    const accountDropdown = document.getElementById("accountDropdown");

    if (accountBtn && accountDropdown) {
        accountBtn.addEventListener("click", function (event) {
            event.stopPropagation();
            accountDropdown.classList.toggle("show");
        });

        document.addEventListener("click", function () {
            accountDropdown.classList.remove("show");
        });

        accountDropdown.addEventListener("click", function (event) {
            event.stopPropagation();
        });
    }
</script>
