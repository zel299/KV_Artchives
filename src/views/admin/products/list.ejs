<header class="page-head row-between">
  <div>
    <h1><%= archived ? 'Archived products' : 'Product list' %></h1>
    <p class="muted">
      <%= archived
          ? 'Products hidden from the catalog. Their order history is kept.'
          : 'Manage your products and keep your shop listings organised.' %>
    </p>
  </div>
  <div class="head-actions">
    <% if (archived) { %>
      <a href="/admin/products" class="btn btn-ghost btn-sm">Active products</a>
    <% } else { %>
      <a href="/admin/products?archived=1" class="btn btn-ghost btn-sm">Archived</a>
      <a href="/admin/products/new" class="btn btn-sm">+ Create product</a>
    <% } %>
  </div>
</header>

<% if (flash) { %><div class="alert alert-ok"><%= flash %></div><% } %>

<form method="get" class="filters">
  <% if (archived) { %><input type="hidden" name="archived" value="1"><% } %>
  <input type="search" name="q" placeholder="Search name or code…" value="<%= search %>">
  <select name="category">
    <option value="">All categories</option>
    <% categories.forEach(function (c) { %>
      <option value="<%= c.id %>" <%= String(categoryId) === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
    <% }); %>
  </select>
  <button type="submit" class="btn btn-ghost btn-sm">Filter</button>
</form>

<% if (products.length === 0) { %>
  <div class="empty">
    <p>No products found.</p>
    <% if (!archived) { %><a href="/admin/products/new" class="btn btn-sm">Add your first product</a><% } %>
  </div>
<% } else { %>
  <table class="table">
    <thead>
      <tr>
        <th>Code</th>
        <th>Name</th>
        <th>Category</th>
        <th class="num">Price</th>
        <th class="num">Stock</th>
        <th class="actions">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% products.forEach(function (p) { %>
        <tr>
          <td class="mono small"><%= p.code %></td>
          <td>
            <a href="/admin/products/<%= p.id %>"><%= p.name %></a>
            <% if (p.isOneOfAKind) { %><span class="badge">one of a kind</span><% } %>
          </td>
          <td class="small muted"><%= p.category ? p.category.name : '—' %></td>
          <td class="num"><%= formatPeso(p.price) %></td>
          <td class="num">
            <% if (p.quantity === 0) { %>
              <span class="badge badge-warn">Sold out</span>
            <% } else { %>
              <%= p.quantity %>
            <% } %>
          </td>
          <td class="actions">
            <a href="/admin/products/<%= p.id %>/edit" class="small">Edit</a>
            <% if (p.isArchived) { %>
              <form method="post" action="/admin/products/<%= p.id %>/restore" class="inline">
                <button type="submit" class="linkish small">Restore</button>
              </form>
            <% } else { %>
              <form method="post" action="/admin/products/<%= p.id %>/archive" class="inline">
                <button type="submit" class="linkish small">Archive</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>

  <div class="row-between pager">
    <span class="small muted">
      Showing <%= products.length %> of <%= total %> product<%= total === 1 ? '' : 's' %>
    </span>
    <% if (totalPages > 1) { %>
      <span class="small">
        <% for (let i = 1; i <= totalPages; i++) { %>
          <a href="?page=<%= i %><%= archived ? '&archived=1' : '' %><%= search ? '&q=' + encodeURIComponent(search) : '' %>"
             class="<%= i === page ? 'current' : '' %>"><%= i %></a>
        <% } %>
      </span>
    <% } %>
  </div>
<% } %>
