<link rel="stylesheet" href="/css/list.css">
<link rel="stylesheet" href="/css/prod-modal.css">

<header class="page-head row-between">

  <div>
    <h1>
      <%= archived ? 'Archived products' : 'Product list' %>
    </h1>

    <p class="muted">
      <%= archived ? 'Products hidden from the catalog. Their order history is kept.'
        : 'Manage your products and keep your shop listings organised.' %>
    </p>
  </div>

  <div class="head-actions">

    <% if (archived) { %>

      <a href="/admin/products" class="btn btn-ghost btn-sm">
        Active products
      </a>

      <% } else { %>

        <a href="/admin/products?archived=1" class="btn btn-ghost btn-sm">
          Archived
        </a>

        <button type="button" class="btn btn-sm" id="openCreateProduct">

          + Create product

        </button>

        <% } %>
  </div>

</header>

<% if (typeof flash !=='undefined' && flash) { %>

  <div class="alert alert-ok">
    <%= flash %>
  </div>

  <% } %>

    <form method="get" class="filters">

      <% if (archived) { %>

        <input type="hidden" name="archived" value="1">

        <% } %>


          <input type="search" name="q" placeholder="Search name or code…" value="<%= search || '' %>">

          <div class="category-select">

            <select name="category">

              <option value="">
                All categories
              </option>

              <% categories.forEach(function (c) { %>

                <option value="<%= c.id %>" <%=String(categoryId)===String(c.id) ? 'selected' : '' %>>

                  <%= c.name %>

                </option>

                <% }); %>

            </select>

            <i class="fa-solid fa-chevron-down category-arrow"></i>

          </div>

          <button type="submit" class="btn btn-ghost btn-sm">

            Filter

          </button>

    </form>

    <% if (products.length===0) { %>

      <div class="empty">

        <p>
          No products found.
        </p>

        <% if (!archived) { %>

          <button type="button" class="btn btn-sm" id="openCreateProduct">

            Add your first product

          </button>

          <% } %>

      </div>

      <% } else { %>


        <table class="table">

          <thead>

            <tr>

              <th>Code</th>

              <th>Name</th>

              <th>Category</th>

              <th class="num">
                Price
              </th>

              <th class="num">
                Stock
              </th>

              <th class="actions">
                Actions
              </th>

            </tr>

          </thead>


          <tbody>

            <% products.forEach(function (p) { %>

              <tr>
                <td class="mono small">
                  <%= p.code %>
                </td>

                <td>

                  <a href="/admin/products/<%= p.id %>">
                    <%= p.name %>
                  </a>

                  <% if (p.isOneOfAKind) { %>

                    <span class="badge">
                      one of a kind
                    </span>

                    <% } %>

                </td>

                <td class="small muted">

                  <%= p.category ? p.category.name : '—' %>

                </td>

                <td class="num">

                  <%= formatPeso(p.price) %>

                </td>

                <td class="num">

                  <% if (p.quantity===0) { %>

                    <span class="badge badge-warn">
                      Sold out
                    </span>

                    <% } else { %>

                      <%= p.quantity %>

                        <% } %>

                </td>

                <td class="actions">

                  <button type="button" class="linkish small edit-product" data-id="<%= p.id %>"
                    data-name="<%= p.name %>" data-description="<%= p.description || '' %>" data-price="<%= p.price %>"
                    data-quantity="<%= p.quantity %>" data-category="<%= p.category ? p.category.id : '' %>"
                    data-category-name="<%= p.category ? p.category.name : '—' %>"
                    data-one-of-a-kind="<%= p.isOneOfAKind ? 'true' : 'false' %>"
                    data-status="<%= p.isArchived ? 'Archived' : 'Active' %>">

                    Edit

                  </button>

                  <button type="button" class="linkish small view-product" data-id="<%= p.id %>"
                    data-name="<%= p.name %>" data-code="<%= p.code %>" data-description="<%= p.description || '' %>"
                    data-price="<%= p.price %>" data-quantity="<%= p.quantity %>"
                    data-category-name="<%= p.category ? p.category.name : '—' %>"
                    data-one-of-a-kind="<%= p.isOneOfAKind ? 'Yes' : 'No' %>"
                    data-status="<%= p.isArchived ? 'Archived' : 'Active' %>">

                    View

                  </button>

                  <% if (p.isArchived) { %>

                    <form method="post" action="/admin/products/<%= p.id %>/restore" class="inline">

                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                      <button type="submit" class="linkish small">

                        Restore

                      </button>

                    </form>

                    <% } else { %>

                      <form method="post" action="/admin/products/<%= p.id %>/archive" class="inline">

                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                        <button type="submit" class="linkish small">

                          Archive

                        </button>

                      </form>

                      <% } %>

                </td>

              </tr>

              <% }); %>

          </tbody>

        </table>

        <div class="row-between pager">

          <span class="small muted">

            Showing
            <%= products.length %>
              of
              <%= total %>
                product<%= total===1 ? '' : 's' %>

          </span>

          <% if (totalPages> 1) { %>

            <span class="small">

              <% for (let i=1; i <=totalPages; i++) { %>

                <a href="?page=<%= i %><%= archived ? '&archived=1' : '' %><%= search ? '&q=' + encodeURIComponent(search) : '' %>"
                  class="<%= i === page ? 'current' : '' %>">

                  <%= i %>

                </a>

                <% } %>

            </span>

            <% } %>

        </div>

        <% } %>

          <div class="product-modal" id="productModal" aria-hidden="true">

            <div class="product-modal-overlay" id="closeProductOverlay">
            </div>

            <div class="product-modal-content">

              <div class="modal-header">

                <div>

                  <h2 id="productModalTitle">
                    Add product
                  </h2>

                  <p class="muted" id="productModalSubtitle">

                    Add a new product to your shop.

                  </p>

                </div>

                <button type="button" class="modal-close" id="closeProductModal" aria-label="Close">

                  &times;

                </button>

              </div>

              <div id="productFormContainer">

                <% if (typeof error !=='undefined' && error) { %>

                  <div class="alert">
                    <%= error %>
                  </div>

                  <% } %>

                    <form method="post" action="/admin/products" enctype="multipart/form-data" class="product-form"
                      id="productForm">

                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                      <label>

                        Product name

                        <input type="text" name="name" id="productName" required maxlength="120">

                      </label>

                      <label>

                        Description

                        <textarea name="description" id="productDescription" rows="4"></textarea>

                      </label>

                      <div class="field-row">

                        <label>

                          Price (₱)

                          <input type="number" name="price" id="productPrice" step="0.01" min="0" required>

                        </label>


                        <label>

                          Stock quantity

                          <input type="number" name="quantity" id="productQuantity" step="1" min="0" value="0">

                        </label>

                      </div>

                      <label>

                        Category

                        <select name="category_id" id="productCategory">

                          <option value="">
                            No category
                          </option>

                          <% categories.forEach(function (c) { %>

                            <option value="<%= c.id %>">
                              <%= c.name %>
                            </option>

                            <% }); %>

                        </select>

                      </label>

                      <label class="checkbox">

                        <input type="checkbox" name="is_one_of_a_kind" id="productOneOfAKind">

                        <span>
                          One of a kind
                        </span>

                        <span class="small muted">

                          Shows a badge on the product page.
                          Does not affect stock.

                        </span>

                      </label>

                      <label>

                        Product photos

                        <input type="file" name="images" accept="image/jpeg,image/png,image/webp" multiple>

                        <span class="small muted">

                          Up to 5 images, 5 MB each.
                          They are compressed automatically.

                        </span>

                      </label>

                      <div class="form-actions">

                        <button type="button" class="btn btn-ghost" id="cancelProductModal">

                          Cancel

                        </button>

                        <button type="submit" class="btn" id="productSubmitButton">
                          Create product
                        </button>

                      </div>
                    </form>
              </div>

              <div id="productViewContainer" class="product-view-container">

                <div class="product-view-header">

                  <div>

                    <h3 id="viewProductName">
                      Product name
                    </h3>

                    <p id="viewProductCode" class="muted mono small">

                      CODE

                    </p>

                  </div>

                  <button type="button" class="btn btn-sm" id="viewEditProduct">

                    Edit

                  </button>

                </div>

                <section class="panel">

                  <dl class="detail-list">

                    <div>

                      <dt>
                        Price
                      </dt>

                      <dd id="viewProductPrice">
                        —
                      </dd>

                    </div>

                    <div>

                      <dt>
                        Stock
                      </dt>

                      <dd id="viewProductStock">
                        —
                      </dd>

                    </div>

                    <div>

                      <dt>
                        Category
                      </dt>

                      <dd id="viewProductCategory">
                        —
                      </dd>

                    </div>

                    <div>

                      <dt>
                        One of a kind
                      </dt>

                      <dd id="viewProductOneOfAKind">
                        —
                      </dd>

                    </div>


                    <div>

                      <dt>
                        Status
                      </dt>

                      <dd id="viewProductStatus">
                        —
                      </dd>

                    </div>

                  </dl>

                  <div id="viewDescriptionSection">

                    <h3 class="small">
                      Description
                    </h3>

                    <p id="viewProductDescription" class="muted">
                    </p>

                  </div>

                </section>

                <section class="panel">

                  <h3 class="small">
                    Photos
                  </h3>


                  <div id="viewProductImages" class="image-grid">
                  </div>


                  <p id="viewNoPhotos" class="muted small">

                    No photos yet. Add some from the edit form.

                  </p>

                </section>

                <section class="panel danger-zone">

                  <h3>
                    Manage
                  </h3>

                  <form method="post" id="viewRestoreForm" class="inline">

                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <button type="submit" class="btn btn-ghost btn-sm">

                      Restore to catalog

                    </button>

                  </form>

                  <form method="post" id="viewArchiveForm" class="inline">

                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <button type="submit" class="btn btn-ghost btn-sm">

                      Archive

                    </button>

                  </form>

                  <p id="viewArchiveText" class="small muted">

                    Archiving hides it from the catalog
                    but keeps its order history.

                  </p>

              <form method="post" id="viewDeleteForm" class="inline"
                    data-confirm="Permanently delete this product? This cannot be undone.">

                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <button type="submit" class="linkish small danger">

                      Delete permanently

                    </button>

                  </form>

                  <p class="small muted">

                    Only possible if the product has never been ordered.

                  </p>
                </section>
              </div>

            </div>
          </div>

          <script src="/js/product-modal.js"></script>