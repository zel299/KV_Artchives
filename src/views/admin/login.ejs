<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <title>Admin portal · KV Artchives</title>

  <link rel="stylesheet" href="/css/admin-login.css">

  <link
    href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;500;600;700&family=Berkshire+Swash&display=swap"
    rel="stylesheet"
  >
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  >
</head>
<body class="admin-auth">

  <main class="admin-auth-card">

    <div class="admin-auth-logo">
      <img src="/images/logo.png" alt="KV Artchives Logo">
    </div>

    <h1>Admin Portal</h1>
    <p class="muted">KV Artchives</p>

    <% if (error) { %><div class="alert"><%= error %></div><% } %>

    <form method="post" action="/admin/login" class="admin-auth-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <label for="email">Email
        <input type="email" id="email" name="email" required autocomplete="email">
      </label>

      <label for="password">Password
        <div class="password-wrapper">
          <input type="password" id="password" name="password" required autocomplete="current-password">
          <button type="button" class="toggle-password" data-target="password" aria-label="Show password">
            <i class="fa-solid fa-eye-slash"></i>
          </button>
        </div>
      </label>

      <button type="submit" class="btn btn-block">Log in</button>
    </form>

    <p class="small center muted">Admin access only.</p>

  </main>

  <script>
    document
      .querySelectorAll(".toggle-password")
      .forEach(function (button) {
        button.addEventListener("click", function () {
          const input = document.getElementById(button.dataset.target);
          if (!input) return;

          if (input.type === "password") {
            input.type = "text";
            button.innerHTML = '<i class="fa-solid fa-eye"></i>';
          } else {
            input.type = "password";
            button.innerHTML = '<i class="fa-solid fa-eye-slash"></i>';
          }
        });
      });
  </script>

</body>
</html>