<link rel="stylesheet" href="/css/dashboard.css">

<header class="page-head">
  <h1>Dashboard</h1>
  <p class="muted">Overview of the shop.</p>
</header>

<div class="stat-grid">
  <div class="stat"><span class="stat-label">Total sales</span><span class="stat-value"><%= formatPeso(stats.sales) %></span></div>
  <div class="stat"><span class="stat-label">Total orders</span><span class="stat-value"><%= stats.orders %></span></div>
  <div class="stat"><span class="stat-label">Transactions</span><span class="stat-value"><%= stats.transactions %></span></div>
  <div class="stat"><span class="stat-label">Customers</span><span class="stat-value"><%= stats.customers %></span></div>
</div>

<section class="panel">
  <h2 class="small">Units Sold — last <%= units.length %> days</h2>

  <% const maxUnits = Math.max(1, ...units.map(function (u) { return u.units; })); %>
  <% const chartWidth = 800; %>
  <% const chartHeight = 140; %>
  <% const topPad = 12; %>
  <% const step = units.length > 1 ? chartWidth / (units.length - 1) : 0; %>

  <% const points = units.map(function (u, i) {
       const x = i * step;
       const y = topPad + (chartHeight - topPad) * (1 - u.units / maxUnits);
       return { x: x, y: y, date: u.date, units: u.units };
     }); %>

  <% const linePoints = points.map(function (p) { return p.x + "," + p.y; }).join(" "); %>
  <% const areaPoints = linePoints + " " + points[points.length - 1].x + "," + chartHeight + " " + points[0].x + "," + chartHeight; %>

  <div class="units-chart">
    <svg viewBox="0 0 <%= chartWidth %> <%= chartHeight %>" preserveAspectRatio="none" class="units-svg">

      <polygon points="<%= areaPoints %>" class="units-area"></polygon>
      <polyline points="<%= linePoints %>" class="units-line"></polyline>

      <% points.forEach(function (p) { %>
        <circle cx="<%= p.x %>" cy="<%= p.y %>" r="4" class="units-dot <%= p.units > 0 ? 'units-dot--active' : '' %>">
          <title><%= p.date %>: <%= p.units %> unit<%= p.units === 1 ? '' : 's' %></title>
        </circle>
      <% }); %>

    </svg>

    <div class="units-dates">
      <% points.forEach(function (p, i) { %>
        <% if (i % 5 === 0) { %>
          <span class="units-date" style="--pos: <%= (p.x / chartWidth) * 100 %>%"><%= p.date.slice(5) %></span>
        <% } %>
      <% }); %>
    </div>
  </div>
</section>

<section class="panel">
  <h2 class="small">Order Status</h2>

  <div class="status-overview">
    <% statuses.forEach(function (s) { %>
      <div class="status-chip">
        <span class="status-chip__label"><%= s.status.replace(/_/g, " ") %></span>
        <span class="status-chip__count"><%= s.count %></span>
      </div>
    <% }); %>
  </div>
</section>

<section class="panel">
  <h2 class="small">Recent Orders</h2>

  <% if (recent.length === 0) { %>

    <p class="muted small">No orders yet.</p>

  <% } else { %>

  <div class="table-scroll">
    <table class="table">
      <thead>
        <tr>
          <th>Code</th>
          <th>Customer</th>
          <th>Status</th>
          <th class="num">Total</th>
          <th>Placed</th>
        </tr>
      </thead>
      <tbody>
        <% recent.forEach(function (o) { %>
          <tr>
            <td class="mono small"><a href="/admin/orders/<%= o.id %>"><%= o.code %></a></td>
            <td><%= o.customerName %></td>
            <td data-label="Status"><span class="badge badge-<%= o.status %>"><%= o.status.replace(/_/g, " ") %></span></td>
            <td class="num"><%= formatPeso(o.subtotal) %></td>
            <td class="small muted"><%= new Date(o.placedAt).toLocaleDateString() %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    </div>

  <% } %>

</section>