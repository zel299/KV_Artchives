
<header class="page-head row-between">
  <div>
    <h1>Orders</h1>
    <p class="muted">Review, confirm, and track every order as it moves through production.</p>
  </div>
</header>

<% if (flash) { %><div class="alert alert-ok"><%= flash %></div><% } %>

<div class="order-tabs">
  <a href="/admin/orders?tab=all" class="tab-pill <%= tab === 'all' ? 'active' : '' %>">All</a>
  <a href="/admin/orders?tab=pending" class="tab-pill <%= tab === 'pending' ? 'active' : '' %>">Pending</a>
  <a href="/admin/orders?tab=awaiting_payment" class="tab-pill <%= tab === 'awaiting_payment' ? 'active' : '' %>">Awaiting Payment</a>
  <a href="/admin/orders?tab=in_progress" class="tab-pill <%= tab === 'in_progress' ? 'active' : '' %>">In Progress</a>
  <a href="/admin/orders?tab=shipped" class="tab-pill <%= tab === 'shipped' ? 'active' : '' %>">Shipped</a>
  <a href="/admin/orders?tab=completed" class="tab-pill <%= tab === 'completed' ? 'active' : '' %>">Completed</a>
  <a href="/admin/orders?tab=closed" class="tab-pill <%= tab === 'closed' ? 'active' : '' %>">Closed</a>
</div>

<form method="get" class="filters">
  <% if (tab && tab !== 'all') { %><input type="hidden" name="tab" value="<%= tab %>"><% } %>
  <input type="search" name="q" placeholder="Search order code or customer…" value="<%= search %>">
  <button type="submit" class="btn btn-ghost btn-sm">Search</button>
</form>

<% if (orders.length === 0) { %>

  <div class="empty">
    <p>No orders found.</p>
  </div>

<% } else { %>

  <table class="table">
    <thead>
      <tr>
        <th>Code</th>
        <th>Customer</th>
        <th>Status</th>
        <th class="num">Total</th>
        <th>Placed</th>
        <th class="actions">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% orders.forEach(function (o) { %>
        <tr>
          <td class="mono small"><%= o.code %></td>
          <td>
            <%= o.customer ? o.customer.full_name : o.shipping.fullName %>
            <div class="small muted"><%= o.customer ? o.customer.email : '' %></div>
          </td>
          <td><span class="badge"><%= o.statusLabel %></span></td>
          <td class="num"><%= formatPeso(o.subtotal) %></td>
          <td class="small muted"><%= new Date(o.placedAt).toLocaleDateString() %></td>
          <td class="actions">
            <a href="/admin/orders/<%= o.id %>" class="small">View</a>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>

  <div class="row-between pager">
    <span class="small muted">
      Showing <%= orders.length %> of <%= total %> order<%= total === 1 ? '' : 's' %>
    </span>
    <% if (totalPages > 1) { %>
      <span class="small">
        <% for (let i = 1; i <= totalPages; i++) { %>
          <a href="?page=<%= i %><%= tab ? '&tab=' + tab : '' %><%= search ? '&q=' + encodeURIComponent(search) : '' %>"
             class="<%= i === page ? 'current' : '' %>"><%= i %></a>
        <% } %>
      </span>
    <% } %>
  </div>

<% } %>