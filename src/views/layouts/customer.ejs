<!DOCTYPE html>
<html lang="en">

<head>

        <link rel="icon" type="image/png" href="/images/favicon.png">

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title ? title + " | KV Artchives" : "KV Artchives" %></title>
    <meta name="description" content="<%= typeof metaDescription !== "undefined" && metaDescription ? metaDescription : "Handmade clay creations from KV Artchives. Browse the shop and order online." %>">

    <link rel="stylesheet" href="/css/nav.css"> 
    
    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Abhaya+Libre:wght@600&family=Albert+Sans:wght@400;500;600;700&family=Averia+Serif+Libre:wght@300;400;700&family=Bebas+Neue&family=Berkshire+Swash&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet"

    >

    <link
        rel="stylesheet"
        href="/css/homepage.css"
    >

    <link
        rel="stylesheet"
        href="/css/nav.css"
    >

        <% if (typeof pageCss !== "undefined" && pageCss) { %>
    <link rel="stylesheet" href="/css/<%= pageCss %>.css">
    <% } %>

    <script src="/js/splash.js"></script>

</head>

<body>

        <% if (currentPath === "/") { %>
        <div class="splash" id="splash" aria-hidden="true">
            <div class="splash-inner">
                <img src="/images/logo.png" alt="" class="splash-logo">
                <p class="splash-title">KV Artchives</p>
                <div class="splash-bar"><span></span></div>
                <p class="splash-tag">Handmade with Love</p>
            </div>
        </div>
    <% } %>

    <%- include('../partials/nav') %>

    <main>
        <%- body %>
    </main>

    <%- include('../partials/footer') %>

    <script src="/js/confirm.js"></script>
    <link rel="stylesheet" href="/css/modal.css">

</body>

</html>