<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Dashboard | KV Artchives</title>

    <link rel="stylesheet" href="/css/admin-layout.css">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Abhaya+Libre:wght@600&family=Albert+Sans:wght@400;500;600;700&family=Averia+Serif+Libre:wght@300;400;700&family=Bebas+Neue&family=Berkshire+Swash&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >
</head>

<body>

<div class="admin-layout">

    <!-- =========================
         SIDEBAR
    ========================== -->
    <aside class="admin-sidebar">

        <!-- Logo -->
        <div class="sidebar-brand">

            <div class="brand-logo">
                <img src="images/logo.png" alt="KV Artchives Logo">
            </div>

            <div class="brand-title">
                <strong>KV Artchives</strong>
                <span>Admin Portal</span>
            </div>

        </div>


        <!-- Navigation -->
        <nav class="sidebar-nav">

            <!-- Overview -->
            <div class="nav-section">

                <p class="nav-section-title">
                    Overview
                </p>

                <a href="/admin/dashboard" class="nav-link active">
                    <span class="nav-icon">
                        <i class="fa-solid fa-grip"></i>
                    </span>

                    <span>Dashboard</span>
                </a>

            </div>


            <!-- Catalog -->
            <div class="nav-section">

                <p class="nav-section-title">
                    Catalog and Sales
                </p>

                <a href="/admin/products" class="nav-link">
                    <span class="nav-icon">
                        <i class="fa-solid fa-box"></i>
                    </span>

                    <span>Products</span>
                </a>

                <a href="/admin/orders" class="nav-link">
                    <span class="nav-icon">
                        <i class="fa-solid fa-cart-shopping"></i>
                    </span>

                    <span>Orders</span>
                </a>

                <a href="/admin/transactions" class="nav-link">
                    <span class="nav-icon">
                        <i class="fa-solid fa-money-bill"></i>
                    </span>

                    <span>Transactions</span>
                </a>

            </div>


            <!-- People -->
            <div class="nav-section">

                <p class="nav-section-title">
                    People and Insights
                </p>

                <a href="/admin/customers" class="nav-link">
                    <span class="nav-icon">
                        <i class="fa-solid fa-user-group"></i>
                    </span>

                    <span>Customers</span>
                </a>

                <a href="/admin/reports" class="nav-link">
                    <span class="nav-icon">
                        <i class="fa-solid fa-chart-column"></i>
                    </span>

                    <span>Reports</span>
                </a>

            </div>


            <!-- System -->
            <div class="nav-section">

                <p class="nav-section-title">
                    System
                </p>

                <a href="/admin/settings" class="nav-link">
                    <span class="nav-icon">
                        <i class="fa-solid fa-gear"></i>
                    </span>

                    <span>Settings</span>
                </a>

            </div>

        </nav>


        <!-- Logout -->
        <div class="sidebar-bottom">

            <a href="/logout" class="nav-link logout-link">

                <span class="nav-icon">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                </span>

                <span>Logout</span>

            </a>

        </div>

    </aside>



    <!-- =========================
         MAIN CONTENT
    ========================== -->
    <main class="admin-main">


        <!-- =========================
             TOP HEADER
        ========================== -->
        <header class="admin-header">

            <div class="header-spacer"></div>

            <div class="header-actions">

                <!-- Notification -->
                <button class="header-icon-btn" type="button">
                    <i class="fa-solid fa-bell"></i>
                </button>


                <!-- Admin -->
                <button class="admin-profile" type="button">

                    <div class="admin-avatar">
                        <i class="fa-solid fa-user"></i>
                    </div>

                    <span class="admin-name">
                        Admin User
                    </span>

                    <i class="fa-solid fa-caret-down profile-arrow"></i>

                </button>

            </div>

        </header>

        <%- body %>

    </main>
</div>

</body>
</html>


